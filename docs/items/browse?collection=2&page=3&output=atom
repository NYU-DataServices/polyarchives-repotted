            <div id="dublin-core-title" class="element">
        <h3>Title</h3>
                    <div class="element-text">Golana Elects Wachsman, Grasso Editors-In-Chief For Coming Year</div>
            </div><!-- end element -->
        <div id="dublin-core-creator" class="element">
