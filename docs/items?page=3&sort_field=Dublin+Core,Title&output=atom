    <content type="html"><![CDATA[<div class="element-set">
        <h2>Dublin Core</h2>
            <div id="dublin-core-title" class="element">
        <h3>Title</h3>
                    <div class="element-text">2001: A Space Odyssey - Videophone Sequence<br />
<br />
</div>
            </div><!-- end element -->
        <div id="dublin-core-subject" class="element">
        <h3>Subject</h3>
                    <div class="element-text">Science Fiction; Videophone; Film Technology; Stanley Kubrick; &quot;2001: A Space Odyssey&quot;</div>
            </div><!-- end element -->
        <div id="dublin-core-description" class="element">
        <h3>Description</h3>
                    <div class="element-text">A clip from &quot;2001: A Space Odyssey&quot; demonstrating one of the earliest cinematic depictions of a videophone, showcasing director Stanley Kubrick&#039;s visionary portrayal of future technology. The sequence is noted for its prescient depiction of communication technology.</div>
            </div><!-- end element -->
        <div id="dublin-core-creator" class="element">
        <h3>Creator</h3>
                    <div class="element-text">Stanley Kubrick (Director)</div>
            </div><!-- end element -->
        <div id="dublin-core-source" class="element">
        <h3>Source</h3>
                    <div class="element-text">YouTube Channel - imaucblog</div>
            </div><!-- end element -->
        <div id="dublin-core-publisher" class="element">
        <h3>Publisher</h3>
                    <div class="element-text">Warner Bros., Metro-Goldwyn-Mayer, United Artists</div>
            </div><!-- end element -->
        <div id="dublin-core-date" class="element">
        <h3>Date</h3>
                    <div class="element-text">Original release date of the movie: April 2, 1968; YouTube clip posted on May 19, 2010</div>
            </div><!-- end element -->
        <div id="dublin-core-contributor" class="element">
        <h3>Contributor</h3>
                    <div class="element-text">Keir Dullea (Actor portraying Dr. Dave Bowman), Arthur C. Clarke (Author of the original story), Geoffrey Unsworth, John Alcott (Cinematographers)</div>
            </div><!-- end element -->
        <div id="dublin-core-rights" class="element">
        <h3>Rights</h3>
                    <div class="element-text">The rights to the clip and the film are owned by the distributors: Warner Bros., Metro-Goldwyn-Mayer, United Artists. The clip is used for educational or critical commentary purposes, potentially covered under fair use.</div>
            </div><!-- end element -->
        <div id="dublin-core-relation" class="element">
        <h3>Relation</h3>
                    <div class="element-text">Related to the broader context of &quot;2001: A Space Odyssey&quot; and its influence on science fiction and technology.<br />
<br />
</div>
            </div><!-- end element -->
        <div id="dublin-core-format" class="element">
        <h3>Format</h3>
                    <div class="element-text">Video clip; Digital</div>
            </div><!-- end element -->
        <div id="dublin-core-language" class="element">
        <h3>Language</h3>
                    <div class="element-text">English</div>
            </div><!-- end element -->
        <div id="dublin-core-type" class="element">
        <h3>Type</h3>
                    <div class="element-text">Film excerpt; Cinematic depiction</div>
            </div><!-- end element -->
        <div id="dublin-core-identifier" class="element">
        <h3>Identifier</h3>
                    <div class="element-text">https://www.youtube.com/watch?v=vWwo6JpMceg</div>
            </div><!-- end element -->
        <div id="dublin-core-coverage" class="element">
        <h3>Coverage</h3>
                    <div class="element-text">The videophone sequence specifically covers future communication technologies as envisioned in a 1968 science fiction film.</div>
            </div><!-- end element -->
    </div><!-- end element-set -->
]]></content>
